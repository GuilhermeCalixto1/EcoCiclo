# Porta do Servidor Node.js
PORT=3001

# URL do seu projeto no Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anon/Public do Supabase (para operações públicas)
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Chave Service Role do Supabase (OPCIONAL para backend - permite bypass de RLS quando necessário)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Origem permitida para CORS
CLIENT_ORIGIN=http://localhost:5173
